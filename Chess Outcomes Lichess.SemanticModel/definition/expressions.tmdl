	annotation PBI_ResultType = Function

expression 'Games Source' =
		let
		    Source = Csv.Document(File.Contents("b:\VS Code Files\PBI Projects\Chess Outcomes\games.csv"), [Delimiter = ",", Columns = 16, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Typed = Table.TransformColumnTypes(Promoted, {
		        {"id", type text},
		        {"created_at", type number},
		        {"last_move_at", type number},
		        {"turns", Int64.Type},
		        {"victory_status", type text},
		        {"winner", type text},
		        {"increment_code", type text},
		        {"white_id", type text},
		        {"white_rating", Int64.Type},
		        {"black_id", type text},
		        {"black_rating", Int64.Type},
		        {"moves", type text},
		        {"opening_eco", type text},
		        {"opening_name", type text},
		        {"opening_ply", Int64.Type}
		    }),
		    IsRated = Table.AddColumn(Typed, "Is Rated", each Text.Upper(Text.From([rated])) = "TRUE", type logical),
		    CreatedDate = Table.AddColumn(IsRated, "Created Date", each
		        let dt = #datetime(1970, 1, 1, 0, 0, 0) + #duration(0, 0, 0, [created_at] / 1000)
		        in #datetime(Date.Year(dt), Date.Month(dt), Date.Day(dt), 0, 0, 0), type datetime),
		    AvgRating = Table.AddColumn(CreatedDate, "Average Player Rating", each ([white_rating] + [black_rating]) / 2, type number),
		    RatingBand = Table.AddColumn(AvgRating, "Rating Band", each
		        let r = [Average Player Rating] in
		        if r < 1000 then "< 1000"
		        else if r < 1250 then "1000 - <1249"
		        else if r < 1500 then "1250 - 1499"
		        else if r < 1750 then "1500 - 1749"
		        else if r < 2000 then "1750 - 1999"
		        else "2000 +", type text),
		    RatingDiff = Table.AddColumn(RatingBand, "Rating Difference", each [white_rating] - [black_rating], Int64.Type),
		    HigherRatedWon = Table.AddColumn(RatingDiff, "Higher-Rated Won", each
		        if [white_rating] > [black_rating] then [winner] = "white"
		        else if [black_rating] > [white_rating] then [winner] = "black"
		        else false, type logical),
		    GameMode = Table.AddColumn(HigherRatedWon, "Game Mode", each if [Is Rated] then "Rated" else "Casual", type text),
		    TurnBand = Table.AddColumn(GameMode, "Turn Band", each
		        if [turns] <= 20 then "1-20"
		        else if [turns] <= 40 then "21-40"
		        else if [turns] <= 60 then "41-60"
		        else if [turns] <= 80 then "61-80"
		        else if [turns] <= 100 then "81-100"
		        else "100+", type text),
		    TurnBandSort = Table.AddColumn(TurnBand, "Turn Band Sort", each
		        if [turns] <= 20 then 1
		        else if [turns] <= 40 then 2
		        else if [turns] <= 60 then 3
		        else if [turns] <= 80 then 4
		        else if [turns] <= 100 then 5
		        else 6, Int64.Type),
		    Renamed = Table.RenameColumns(TurnBandSort, {
		        {"id", "Id"},
		        {"winner", "Winner"},
		        {"victory_status", "Victory Status"},
		        {"increment_code", "Increment Code"},
		        {"white_rating", "White Rating"},
		        {"black_rating", "Black Rating"},
		        {"turns", "Turns"},
		        {"opening_eco", "Opening ECO"},
		        {"opening_name", "Opening Name"},
		        {"opening_ply", "Opening Ply"}
		    }),
		    Removed = Table.RemoveColumns(Renamed, {"rated", "created_at", "last_move_at", "white_id", "black_id", "moves"})
		in
		    Removed
	lineageTag: dc60af7e-fe50-4d3f-8d9b-a97f74fa59f1
	queryGroup: Others

	annotation PBI_ResultType = Table

